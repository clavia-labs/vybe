{
  "name": "vybez",
  "version": "0.3.0",
  "description": "Typed soft expressions for TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavia-labs/vybez.git"
  },
  "homepage": "https://github.com/clavia-labs/vybez#readme",
  "bugs": {
    "url": "https://github.com/clavia-labs/vybez/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run typecheck && tsc -p tsconfig.json",
    "check": "bun run lint && bun run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "demo": "bun run examples/demo.ts",
    "vm": "bun run examples/jev-vm.ts",
    "vm:eval": "bun run examples/jev-vm/eval.ts",
    "infer": "bun run examples/infer.ts"
  },
  "devDependencies": {
    "@temporalio/client": "^1.15.0",
    "@temporalio/worker": "^1.15.0",
    "@temporalio/workflow": "^1.15.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
